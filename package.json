{
  "name": "budzetbik-desktop",
  "version": "1.2.1",
  "description": "Desktop verzija BudžetBik aplikacije",
  "main": "src/main/main.js",
  "scripts": {
    "start": "cross-env NODE_ENV=development electron .",
    "start:renderer": "cd ../web && npm run dev",
    "dev": "concurrently \"npm run start:renderer\" \"wait-on http://localhost:3001 && npm start\"",
    "prebuild": "cd ../web && npm run build && robocopy build ../desktop/build /E /NFL /NDL /NJH /NJS /nc /ns /np || exit 0",
    "build": "electron-builder",
    "build:win": "npm run prebuild && electron-builder --win",
    "build:mac": "npm run prebuild && electron-builder --mac",
    "build:linux": "npm run prebuild && electron-builder --linux",
    "build:all": "npm run prebuild && electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.budzetbik.desktop",
    "productName": "BudžetBik",
    "directories": {
      "output": "dist-v1.2.1"
    },
    "files": [
      "src/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/ikona.ico",
      "artifactName": "BudžetBik Setup v${version}.exe"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "build/ikona.icns",
      "artifactName": "BudžetBik v${version}.dmg"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/ikona.png",
      "artifactName": "BudžetBik v${version}.AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BudžetBik"
    }
  },
  "devDependencies": {
    "electron": "^27.1.3",
    "electron-builder": "^24.6.4",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "cross-env": "^7.0.3"
  }
}
